{
  "name": "iem-tool",
  "version": "2.0.0",
  "description": "🎧 IEM Tool - Parametric EQ & Frequency Response Analyzer",
  "main": "main.js",
  "author": "🍄 MyLittlePrimordia",
  "license": "MIT",
  "desktopName": "iem-tool",
  "scripts": {
    "prestart": "npm run check && node scripts/build-bundle.mjs",
    "start": "electron .",
    "predist": "npm run package:prepare",
    "dist": "electron-builder --publish never",
    "predist-win": "npm run package:prepare",
    "dist-win": "electron-builder --win --publish never",
    "predist-mac": "npm run package:prepare",
    "dist-mac": "electron-builder --mac --publish never",
    "predist-linux": "npm run package:prepare",
    "dist-linux": "electron-builder --linux --publish never",
    "package:prepare": "npm run check && node scripts/build-bundle.mjs --strict",
    "build:js": "node scripts/build-bundle.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:reach": "node scripts/check-reachability.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "check:workflow": "node tools/check-workflow.js",
    "check": "npm run check:js && npm run check:reach && npm run check:integrity && npm run check:workflow",
    "verify:ui": "node tools/run-ui-verify.mjs",
    "build:css": "tailwindcss -c twbuild/tailwind.config.js -i twbuild/input.css -o app/css/tailwind.output.css --minify"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "tailwindcss": "^3.4.19",
    "terser": "^5.50.0"
  },
  "build": {
    "appId": "com.mylittleprimordia.iemtool",
    "productName": "IEM Tool",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "index.html",
      "app/css/**/*",
      "app/js/**/*",
      "app/icons/**/*",
      "app/fonts/**/*",
      "app/audio/**/*",
      "app/sounds/**/*",
      "app/effects/**/*",
      "app/icon.*",
      "app/favicon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IEM Tool"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "app/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.png",
      "category": "Utility",
      "syncDesktopName": true
    },
    "extraResources": [
      {
        "from": "database.json",
        "to": "database.json"
      },
      {
        "from": "database.json.gz",
        "to": "database.json.gz"
      },
      {
        "from": "data",
        "to": "data"
      }
    ]
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
